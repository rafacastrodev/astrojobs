# DB
POSTGRES_HOST=postgres
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE_RESUMES=
PINECONE_NAMESPACE_JOBS=
EMBEDDING_DIMENSIONS=

# LLM (OpenAI-compatible). Only key + model need to change.
# Gemini: LLM_MODEL=gemini-3.6-flash
# OpenAI: LLM_MODEL=gpt-5.4-nano
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# OpenAI (embeddings / legacy aliases)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=0

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# AWS / S3
# Put keys in this file. An AWS_SECRET_ACCESS_KEY exported in your shell
# overrides Compose interpolation and will not match AWS_ACCESS_KEY_ID here.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=

# AgentCore / Bedrock Knowledge Base
AWS_BEDROCK_KB_NAME=astrojobs-kb
AWS_BEDROCK_DATA_SOURCE=astrojobs-kb-data-source
AWS_BEDROCK_GATEWAY=astrojobs-gateway
AWS_BEDROCK_GATEWAY_TARGET=astrojobs-target
AWS_BEDROCK_TOKEN=
AGENTCORE_GATEWAY_URL=
AGENTCORE_RETRIEVE_TOOL=
BEDROCK_KNOWLEDGE_BASE_ID=

# Outras
JWT_SECRET=
JWT_EXPIRES_MINUTES=
COOKIE_SECURE=
FRONTEND_ORIGIN=
ENVIRONMENT=development
MAX_UPLOAD_BYTES=
MAX_LLM_INPUT_CHARS=
VITE_API_URL=
