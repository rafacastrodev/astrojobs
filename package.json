{
  "name": "astrojobs",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "cd ./apps/api && uv run uvicorn main.server:app --app-dir src --reload --host 0.0.0.0 --port 8000",
    "up": "docker compose up -d --build --remove-orphans",
    "down": "docker compose down --remove-orphans",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "concurrently": "^9.2.4",
    "husky": "^9.1.7"
  }
}
